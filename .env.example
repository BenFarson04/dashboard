# Public OAuth identifiers only. These values are not secrets.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=your-microsoft-entra-spa-client-id
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
# -----------------------------------------------------------------------------
# Environment template — copy to `.env.local` and fill in when wiring live APIs.
# NOTHING here is required to run the app in mock mode. Do NOT commit real values.
# Only variables prefixed with VITE_ are exposed to the browser — keep SECRETS on a
# backend, never in these client-visible vars.
# -----------------------------------------------------------------------------

# --- Microsoft identity (MSAL) — client-safe values only ---------------------
# The client ID and tenant are not secrets, but the client *secret* must live on a
# backend, never here.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=common
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# --- News API (optional; prefer routing through a backend proxy) -------------
# If you use a keyed news API, proxy it via a small backend so the key stays server-side.
# VITE_NEWS_API_BASE=http://localhost:8787/api/news

# --- Weather ------------------------------------------------------------------
# Open-Meteo needs no key. If you use a keyed provider, proxy it via a backend.
# VITE_WEATHER_API_BASE=https://api.open-meteo.com/v1
